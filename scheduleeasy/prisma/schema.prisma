// ScheduleEasy — Prisma Schema
// Provider: SQLite (local dev), UTC timestamps throughout

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums (SQLite uses strings) ─────────────────────────────────────────────

// User roles
// CUSTOMER  — can browse & book appointments
// PROVIDER  — can manage own availability & view appointments
// ADMIN     — full administrative access

// Appointment statuses
// PENDING    — booked, awaiting confirmation
// CONFIRMED  — confirmed
// CANCELLED  — cancelled
// COMPLETED  — appointment has passed and is marked done
// RESCHEDULED — moved; a new appointment should reference this one

// Audit event types
// CREATED / RESCHEDULED / CANCELLED / STATUS_CHANGED / REMINDER_SENT

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CUSTOMER") // CUSTOMER | PROVIDER | ADMIN
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  provider     Provider?
  appointments Appointment[] @relation("CustomerAppointments")
  auditLogs    AuditLog[]
}

model Provider {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      ProviderService[]
  availability  Availability[]
  appointments  Appointment[]      @relation("ProviderAppointments")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  durationMin Int      // duration in minutes
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providers    ProviderService[]
  appointments Appointment[]
}

// Many-to-many: Provider ↔ Service
model ProviderService {
  providerId String
  serviceId  String
  assignedAt DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
}

// Recurring availability blocks per provider (e.g. Mon 09:00–17:00)
model Availability {
  id         String   @id @default(cuid())
  providerId String
  dayOfWeek  Int      // 0=Sun … 6=Sat
  startTime  String   // "HH:MM" in 24h, local business time (display only; slots generated in UTC)
  endTime    String   // "HH:MM"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Appointment {
  id           String   @id @default(cuid())
  customerId   String
  providerId   String
  serviceId    String
  startsAt     DateTime // UTC
  endsAt       DateTime // UTC
  status       String   @default("CONFIRMED") // CONFIRMED | CANCELLED | COMPLETED | RESCHEDULED
  notes        String?
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // For reschedule chain: previous appointment id
  rescheduledFromId String?

  customer  User     @relation("CustomerAppointments", fields: [customerId], references: [id])
  provider  Provider @relation("ProviderAppointments", fields: [providerId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])

  rescheduledFrom Appointment?  @relation("RescheduleChain", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment[] @relation("RescheduleChain")

  auditLogs AuditLog[]
}

model AuditLog {
  id            String   @id @default(cuid())
  appointmentId String
  actorId       String?  // null = system
  actorRole     String?
  eventType     String   // CREATED | RESCHEDULED | CANCELLED | STATUS_CHANGED | REMINDER_SENT
  beforeState   String?  // JSON snapshot
  afterState    String?  // JSON snapshot
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  actor       User?       @relation(fields: [actorId], references: [id])
}
